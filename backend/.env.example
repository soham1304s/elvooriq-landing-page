# Backend Environment Template
# Copy this file to .env and configure your values.
# NEVER commit your real .env file!

DATABASE_URL="postgresql://username:password@localhost:5432/elvooriq_db?schema=public"
PORT=5000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_key_change_in_production
DB_ENCRYPTION_KEY=your_32_byte_db_encryption_key_here

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:5000/api/live/youtube/callback
