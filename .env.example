# ELVOORIQ Enterprise Platform - Environment Variables Template
# Copy this file to .env and configure your environment-specific credentials.
# NEVER commit your real .env file or real secrets to version control!

# Database Configuration (PostgreSQL / Neon)
DATABASE_URL="postgresql://username:password@localhost:5432/elvooriq_db?schema=public"
DATABASE_URL_UNPOOLED="postgresql://username:password@localhost:5432/elvooriq_db?schema=public"
NEON_BRANCH=production

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_in_production
DB_ENCRYPTION_KEY=your_32_byte_db_encryption_key_here

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# YouTube Live Streaming Integration (Optional)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:5000/api/live/youtube/callback
